# Real /proc data only: invoked by CTest on Linux.
execute_process(COMMAND "${SYSCOPE}" log --duration 2 --output "${OUTPUT}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Logging failed: ${stdout}${stderr}")
endif()
file(STRINGS "${OUTPUT}" rows)
list(LENGTH rows count)
if(NOT count EQUAL 3)
    message(FATAL_ERROR "Expected header plus two real samples; got ${count} rows")
endif()
list(REMOVE_AT rows 0)
foreach(row IN LISTS rows)
    string(REPLACE "," ";" fields "${row}")
    list(GET fields 1 cpu)
    list(GET fields 2 total)
    list(GET fields 3 available)
    list(GET fields 4 used)
    if(NOT cpu MATCHES "^[0-9]+[.][0-9]+$" OR cpu LESS 0 OR cpu GREATER 100)
        message(FATAL_ERROR "Invalid measured CPU: ${row}")
    endif()
    math(EXPR expected_used "${total} - ${available}")
    if(total LESS_EQUAL 0 OR available LESS 0 OR used LESS 0 OR NOT used EQUAL expected_used)
        message(FATAL_ERROR "Invalid measured memory: ${row}")
    endif()
endforeach()
file(REMOVE "${OUTPUT}")
